{
  "name": "gatehouse",
  "productName": "Gatehouse",
  "version": "1.0.0",
  "description": "SSH client and security gateway that lets Claude reach your servers only through audited MCP tools.",
  "author": "Gatehouse",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:renderer": "vite build --config vite.config.mts",
    "build:main": "node scripts/build-main.mjs",
    "build:bridge": "bash scripts/build-bridge.sh",
    "build": "npm run build:bridge && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "dist:mac": "electron-builder --mac --publish never",
    "test:e2e": "xvfb-run -a node tests/e2e/ui.cjs test-results/shots",
    "icons": "node scripts/make-icons.cjs"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh-config": "5.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woodyair233-oss/claude.git",
    "directory": "Gatehouse"
  }
}
