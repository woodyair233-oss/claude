<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        app:alignItems="center"
        app:flexWrap="wrap">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mode_point"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ActivityMain_ModePoint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mode_route"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ActivityMain_ModeRoute" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_flexGrow="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_favorites"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ActivityMain_Favorites"
            android:text="&#9733;"
            android:textSize="18sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_settings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ActivityMain_Settings"
            android:text="&#9881;"
            android:textSize="18sp" />
    </com.google.android.flexbox.FlexboxLayout>

    <!-- Point mode: coordinates -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/bar_point"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        app:alignItems="center"
        app:flexWrap="wrap">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editTextLat"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="@string/ActivityMain_Lat"
            android:inputType="numberSigned|numberDecimal"
            app:layout_flexGrow="10" />

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editTextLng"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="@string/ActivityMain_Long"
            android:inputType="numberSigned|numberDecimal"
            app:layout_flexGrow="10" />
    </com.google.android.flexbox.FlexboxLayout>

    <!-- Route mode: waypoint summary and movement settings -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/bar_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:alignItems="center"
        app:flexWrap="wrap">

        <TextView
            android:id="@+id/text_route_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_flexGrow="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_route_undo"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/ActivityMain_RouteUndo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_route_clear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ActivityMain_RouteClear" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:alignItems="center"
            app:flexWrap="wrap">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edit_route_speed"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:hint="@string/ActivityMain_SpeedHint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/ActivityMain_SpeedUnit" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinner_loop_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/LoopModes" />
        </com.google.android.flexbox.FlexboxLayout>
    </com.google.android.flexbox.FlexboxLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingBottom="6dp"
        app:alignItems="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_applyStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ActivityMain_Apply"
            app:layout_flexGrow="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_pause"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/Action_Pause"
            android:visibility="gone" />
    </com.google.android.flexbox.FlexboxLayout>

    <WebView
        android:id="@+id/webView0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />
</androidx.appcompat.widget.LinearLayoutCompat>
